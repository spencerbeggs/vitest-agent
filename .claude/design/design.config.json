{
	"$schema": "../../.claude/skills/design-config/json-schemas/current.json",
	"integration": {
		"ci": {
			"enabled": false,
			"syncOnMerge": false,
			"validateOnPR": false
		},
		"git": {
			"requireReviewForChanges": false,
			"trackDesignDocs": true
		},
		"plans": {
			"autoSyncProgress": false,
			"bidirectionalLinking": true,
			"cacheMetadata": true,
			"cacheTTL": 300,
			"enabled": true,
			"validateOnCommit": true
		}
	},
	"modules": {
		"vitest-agent": {
			"categories": ["architecture", "performance", "integration", "testing", "documentation"],
			"designDocsPath": ".claude/design/vitest-agent",
			"maintainer": "C. Spencer Beggs",
			"path": ".",
			"userDocs": {
				"readme": "README.md",
				"repoDocs": null,
				"siteDocs": "website/docs/en"
			}
		}
	},
	"paths": {
		"context": "CLAUDE.md",
		"designDocs": ".claude/design",
		"localContext": "CLAUDE.local.md",
		"plans": ".claude/plans",
		"skills": ".claude/skills"
	},
	"project": {
		"maintainer": "C. Spencer Beggs",
		"name": "spencerbeggs/vitest-agent",
		"repository": "https://github.com/spencerbeggs/vitest-agent",
		"type": "package"
	},
	"quality": {
		"context": {
			"childMaxLines": 300,
			"requireDesignDocPointers": true,
			"rootMaxLines": 500
		},
		"designDocs": {
			"maxLineLength": 120,
			"requireFrontmatter": true,
			"requireTOC": false
		},
		"plans": {
			"archiveAfterDays": 30,
			"maxLineLength": 120,
			"progressRange": [0, 100],
			"requiredFields": ["name", "title", "created", "status", "progress"],
			"requireFrontmatter": true,
			"stalenessThresholdDays": 30,
			"validStatuses": ["ready", "in-progress", "blocked", "completed", "abandoned"]
		}
	},
	"skills": {
		"baseNamespace": "/",
		"enabled": [
			"design-init",
			"design-validate",
			"design-update",
			"design-sync",
			"design-prune",
			"design-review",
			"design-audit",
			"design-search",
			"design-index",
			"design-export",
			"design-compare",
			"design-link",
			"design-report",
			"design-archive",
			"design-config",
			"plan-validate",
			"plan-create",
			"plan-list"
		]
	},
	"version": "1.0.0"
}
