{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"extends": ["@savvy-web/silk/biome"],
	"overrides": [
		{
			"assist": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			},
			"includes": ["plugin/builds/**"],
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["**/__test__/**"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	],
	"root": true
}
