{
	"name": "vitest-agent",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for vitest-agent development",
	"homepage": "https://github.com/spencerbeggs/vitest-agent#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/vitest-agent.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --log-prefix=none",
		"build:docs": "turbo run build --filter=docs --output-logs=new-only",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod",
		"ci:test": "CI=\"true\" vitest run --coverage",
		"claude": "claude --plugin-dir plugin",
		"dev": "turbo run dev --filter=docs",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 '**/*.{md,mdx}' --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"preview": "turbo run preview --filter=docs",
		"test": "vitest run",
		"test:bats": "env $(env | grep -oE \"^VITEST_AGENT_[A-Z_]+\" | sed \"s/^/-u /\" | tr \"\\n\" \" \") bats plugin/hooks/__test__/",
		"test:coverage": "vitest run",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@savvy-web/silk": "^3.11.6",
		"@vitest-agent/cli": "workspace:*",
		"@vitest-agent/mcp": "workspace:*",
		"@vitest-agent/plugin": "workspace:*"
	},
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.8.1",
				"onFail": "ignore"
			}
		]
	}
}
