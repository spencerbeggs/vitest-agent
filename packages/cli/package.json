{
	"name": "@vitest-agent/cli",
	"version": "4.1.11",
	"private": true,
	"description": "On-demand CLI for vitest-agent. Reads cached test data and reports status, overview, coverage, history, trends, and cache health.",
	"keywords": ["vitest", "agent", "cli", "tests", "coverage"],
	"homepage": "https://github.com/spencerbeggs/vitest-agent#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/vitest-agent/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/vitest-agent.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./main": "./src/main.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"vitest-agent": "./src/bin.ts"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/sql-sqlite-node": "catalog:effected",
		"@effected/cli-kit": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/env": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/kit": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@vitest-agent/engine": "workspace:*",
		"@vitest-agent/sdk": "workspace:*",
		"@vitest-agent/sidecar": "workspace:*",
		"effect": "catalog:effected"
	},
	"devDependencies": {
		"@types/node": "catalog:effected:build",
		"typescript": "catalog:effected:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
