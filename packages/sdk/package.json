{
	"name": "@vitest-agent/sdk",
	"version": "5.1.2",
	"private": true,
	"description": "Platform-free core for the vitest-agent package family: Effect Schema definitions, reporter and dispatcher contracts, errors, formatters, and pure utilities.",
	"keywords": ["vitest", "agent", "shared", "effect", "sqlite"],
	"homepage": "https://github.com/spencerbeggs/vitest-agent#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/vitest-agent/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/vitest-agent.git",
		"directory": "packages/sdk"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./dispatch": "./src/dispatch.ts",
		"./schemas/*.json": "./schemas/*.json",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"schema:build": "schemastore build lib/configs/schemastore.config.ts",
		"schema:check": "schemastore check lib/configs/schemastore.config.ts",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"acorn": "^8.18.0",
		"acorn-typescript": "^1.4.13",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/schemastore": "catalog:effected",
		"@effected/schemastore-cli": "catalog:effected",
		"@savvy-web/bundler": "^2.4.11",
		"@types/node": "catalog:build",
		"typescript": "catalog:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
