{
	"name": "@vitest-agent/ui",
	"version": "6.0.5",
	"private": true,
	"description": "Shared event-sourced renderer for vitest-agent. React Ink view for humans, plain-string view for agents, both fed by the same reducer over a RunEvent stream.",
	"keywords": ["vitest", "ui", "ink", "react", "llm", "ai", "agent", "testing", "coverage"],
	"homepage": "https://github.com/spencerbeggs/vitest-agent#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/vitest-agent/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/vitest-agent.git",
		"directory": "packages/ui"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./ink": "./src/ink/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@vitest-agent/sdk": "workspace:*",
		"effect": "catalog:effected:exact"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/cli-kit": "catalog:effected",
		"@effected/env": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"@types/react": "catalog:effected:build",
		"ink": "catalog:effected:build",
		"react": "catalog:effected:build",
		"typescript": "catalog:effected:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@effected/cli-kit": "catalog:effected:peers",
		"@effected/env": "catalog:effected:peers",
		"@effected/glob": "catalog:effected:peers",
		"@effected/walker": "catalog:effected:peers",
		"ink": "catalog:effected:build:peers",
		"react": "catalog:effected:build:peers"
	},
	"peerDependenciesMeta": {
		"ink": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
