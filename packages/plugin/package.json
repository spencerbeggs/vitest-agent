{
	"name": "@vitest-agent/plugin",
	"version": "6.0.14",
	"private": true,
	"description": "Vitest plugin for the vitest-agent ecosystem: owns persistence, classification, baselines, trends, and dispatches rendering to a configurable reporter.",
	"keywords": ["vitest", "vitest-plugin", "agent", "llm", "ai", "testing", "sqlite", "coverage", "mcp"],
	"homepage": "https://github.com/spencerbeggs/vitest-agent#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/vitest-agent/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/vitest-agent.git",
		"directory": "packages/plugin"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"vitest-agent": "./src/bin/vitest-agent.ts",
		"vitest-agent-mcp": "./src/bin/vitest-agent-mcp.ts"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected:exact",
		"@effected/cli-kit": "catalog:effected:exact",
		"@effected/commands": "catalog:effected:exact",
		"@effected/env": "catalog:effected:exact",
		"@effected/glob": "catalog:effected:exact",
		"@effected/walker": "catalog:effected:exact",
		"@effected/workspaces": "catalog:effected:exact",
		"@vitest-agent/cli": "workspace:*",
		"@vitest-agent/engine": "workspace:*",
		"@vitest-agent/mcp": "workspace:*",
		"@vitest-agent/reporter": "workspace:*",
		"@vitest-agent/sdk": "workspace:*",
		"effect": "catalog:effected:exact",
		"magic-string": "^1.4.5"
	},
	"devDependencies": {
		"@effected/memfs": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"@vitest/coverage-istanbul": "catalog:test",
		"@vitest/coverage-v8": "catalog:test",
		"typescript": "catalog:effected:build",
		"vite": "^8.3.0",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@vitest/coverage-istanbul": "catalog:test:peers",
		"@vitest/coverage-v8": "catalog:test:peers",
		"vitest": "catalog:test:peers"
	},
	"peerDependenciesMeta": {
		"@vitest/coverage-istanbul": {
			"optional": true
		},
		"@vitest/coverage-v8": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
